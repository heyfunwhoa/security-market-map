{
  "name": "security-market-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:research-integrity": "node --experimental-strip-types --test scripts/catalog-integrity.test.mjs",
    "docs:personas": "UPDATE_PERSONA_DOCS=1 vitest run lib/persona-model.test.ts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "storybook:build": "storybook build",
    "context:md": "UPDATE_CONTEXT_MD=1 vitest run lib/context-md.test.ts",
    "context:mcp": "node scripts/context-mcp-server.mjs",
    "export:stix": "node --experimental-strip-types scripts/export-stix.ts",
    "export:feed": "UPDATE_INCIDENT_FEED_EXPORT=1 vitest run lib/incident-feed-export.test.ts",
    "feeds:watch": "node --experimental-strip-types scripts/watch-market-feeds.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "cytoscape": "^3.35.0",
    "inngest": "^4.26.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.5",
    "storybook": "^10.6.7",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "$zod",
    "minimatch@>=9.0.0 <11.0.1": "^11.0.4",
    "glob": "^14.0.3",
    "tsconfck": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  }
}
