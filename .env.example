# Optional discovery adapters. The app never calls them at startup.
# Leave both blank to run on the local seed.
# Phase 1 research checks use offline fixtures and mocks. They do not call
# Exa or Firecrawl, even when a key is present. Live retrieval is not implemented.
FIRECRAWL_API_KEY=
EXA_API_KEY=

# Inngest. Local Dev Server: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev`.
# Production: leave INNGEST_DEV unset and set the Cloud signing and event keys.
# With neither a dev flag nor a signing key, /api/inngest returns HTTP 503.
# This repo has not been synced to Inngest Cloud.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
