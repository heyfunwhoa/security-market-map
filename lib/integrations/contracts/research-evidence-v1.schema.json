{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heyfunwhoa/technical-docs-platform/contracts/research-evidence-v1.schema.json",
  "title": "ResearchEvidencePackageV1",
  "description": "Approved public research evidence from Account Signal Engine Research Hub for Security Market Map consumption. Synthetic/public fixtures only in this repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "reviewStatus",
    "epistemicStatus",
    "classification",
    "subject",
    "statement",
    "sources",
    "interpretations",
    "marketMapRefs",
    "producedAt",
    "correlationId"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^evidence:[a-z0-9-]+$" },
    "kind": { "enum": ["sourced_fact", "vendor_claim"] },
    "reviewStatus": { "enum": ["approved"] },
    "epistemicStatus": { "enum": ["observed", "reported"] },
    "classification": { "enum": ["public", "public-reviewed"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["vendor", "product", "category", "capability"] },
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" }
      }
    },
    "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "canonicalUrl",
          "publisher",
          "retrievedAt",
          "contentHash",
          "sourceVersion"
        ],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^source:[a-z0-9-]+$" },
          "canonicalUrl": { "type": "string", "pattern": "^https://" },
          "publisher": { "type": "string", "minLength": 1 },
          "publishedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
          "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceVersion": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string", "maxLength": 420 }
        }
      }
    },
    "interpretations": {
      "type": "array",
      "description": "Machine or analyst interpretations kept separate from sources/facts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^interpretation:[a-z0-9-]+$" },
          "kind": { "enum": ["ai_hypothesis", "analyst_note"] },
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["unreviewed", "supported", "rejected", "superseded"] }
        }
      }
    },
    "marketMapRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendorIds": { "type": "array", "items": { "type": "string" } },
        "productIds": { "type": "array", "items": { "type": "string" } },
        "categoryIds": { "type": "array", "items": { "type": "string" } },
        "capabilityIds": { "type": "array", "items": { "type": "string" } },
        "unresolvedRefs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs that could not be linked; consumer must show unknown/unresolved"
        }
      }
    },
    "supersedes": { "type": ["string", "null"], "pattern": "^evidence:[a-z0-9-]+$" },
    "invalidatedBySourceCorrection": { "type": "boolean", "default": false },
    "producedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "correlationId": { "type": "string", "minLength": 8 },
    "idempotencyKey": { "type": "string", "minLength": 8 }
  }
}
